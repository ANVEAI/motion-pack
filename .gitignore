music/demo/stills/*.png
terminal/previews/*.png
transitions/renders/*.frames.json
transitions/renders/_tmp*

# --- template build products (make.mjs / render3d.sh) ---
templates/*/assets/
templates/*/out/dev*/
templates/*/out/*.wav
templates/*/out/*.wav.json
templates/*/out/render*.log
templates/demo-type-layout/out/*.mp4
templates/demo-r3-type/out/*.mp4
# the cards/objects demo: MP4s (demo + 3D plate) stay out of git; out/sheet.jpg, plan.json and pin-track.json are committed
templates/demo-cards-objects/out/*.mp4
objects/qa/*/log.txt
objects/tools/tmp/
**/tmp/chrome-*/

# --- terminal/ bakes (terminal/bake-plate.sh: MP4 + GIF master + JSON; only the JPEG previews are committed) ---
terminal/tests/out/
terminal/out/
plates/

# --- Blender renders (blender/tests/showcase.sh writes ./showcase; smoke and determinism tests write blender/tests/out) ---
/showcase/
blender/tests/out/
blender/.cache/

# --- third-party sets fetched by scripts/fetch-external.sh (never committed) ---
external/

# --- maintainer-only release audit (describes what was removed; never publish) ---
AUDIT.md

# --- tooling ---
node_modules/
# only the root lockfile (from optional `npm i --no-save` test tooling); physics/package-lock.json is committed
/package-lock.json
__pycache__/
*.pyc
.pytest_cache/
_site/
.DS_Store

# --- demo-ui-kit: the rendered MP4 stays out of git (plan.json + sheet.jpg are committed) ---
templates/demo-ui-kit/out/*.mp4
