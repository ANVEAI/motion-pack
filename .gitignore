# --- generated heavy media: regenerate with sfx/build_library.py and music/build_music.py (version-matched). The GitHub Release zips match the release they are attached to (v0.2.0 matches its tag) ---
sfx/library/
sfx/library_ext/
music/library/
music/demo/out/
sfx/demo/out/
# full-size PNG renders: tools/make_previews.py turns them into committed JPEG previews
transitions/renders/**/*.png
layers/demo/out/*.png
!layers/demo/out/plate-test.png
type/demo/out/*.png
!type/demo/out/icons.png
camera/demo/out/*.png
objects/qa/**/*.png
sfx/demo/stills/*.png
music/demo/stills/*.png
terminal/previews/*.png
transitions/renders/*.frames.json
transitions/renders/_tmp*

# --- template build products (make.mjs / render3d.sh) ---
templates/*/assets/
templates/*/out/dev*/
templates/*/out/*.wav
templates/*/out/*.wav.json
templates/*/out/render*.log
templates/demo-type-layout/out/*.mp4
templates/demo-r3-type/out/*.mp4
# the cards/objects demo: MP4s (demo + 3D plate) stay out of git; out/sheet.jpg, plan.json and pin-track.json are committed
templates/demo-cards-objects/out/*.mp4
objects/qa/*/log.txt
objects/tools/tmp/
**/tmp/chrome-*/

# --- terminal/ bakes (terminal/bake-plate.sh: MP4 + GIF master + JSON; only the JPEG previews are committed) ---
terminal/tests/out/
terminal/out/
plates/

# --- Blender renders (blender/tests/showcase.sh writes ./showcase; smoke and determinism tests write blender/tests/out) ---
/showcase/
blender/tests/out/
blender/.cache/

# --- third-party sets fetched by scripts/fetch-external.sh (never committed) ---
external/

# --- maintainer-only release audit (describes what was removed; never publish) ---
AUDIT.md

# --- tooling ---
node_modules/
.venv/
# only the root lockfile (from optional `npm i --no-save` test tooling); physics/package-lock.json is committed
/package-lock.json
__pycache__/
*.pyc
.pytest_cache/
_site/
.DS_Store

# --- demo-ui-kit: the rendered MP4 stays out of git (plan.json + sheet.jpg are committed) ---
templates/demo-ui-kit/out/*.mp4
templates/demo-r3-ui/out/*.mp4
# --- demo-r45-ui: the rendered MP4 stays out of git (plan.json + sheet.jpg are committed) ---
templates/demo-r45-ui/out/*.mp4
# --- demo-r3-fx: MP4s (demo + logo plate), the environment still and its render folder stay out of git; plan.json, screen-quad.json, sheet.jpg are committed ---
templates/demo-r3-fx/out/*.mp4
templates/demo-r3-fx/out/env/
templates/demo-r3-fx/out/plate-env.jpg
templates/demo-r3-fx/out/*.frames.json
# --- demo-r45-type: the rendered MP4 stays out of git (plan.json + sheet.jpg are committed) ---
templates/demo-r45-type/out/*.mp4

# a transient matte sequence made by type/tests/r45type.test.mjs --chrome (deleted after the run)
type/demo/out/matte-tmp-*/

# --- multi-voice-doc: the placeholder demo MP4 stays out of git (plan.json, transcript.json and sheet.jpg are committed; vo.wav is covered by templates/.gitignore) ---
templates/multi-voice-doc/out/*.mp4

# --- proof-film: the rendered MP4s (16:9 and 9:16) stay out of git (plan.json, plan-tall.json and the sheets are committed) ---
templates/proof-film/out/*.mp4
templates/proof-film/out/ears*.md
templates/proof-film/out/transcript.json
templates/proof-film/tall/assets/
templates/demo-r6-pivot/out/*.mp4

# scratch template copies (tests and measurements make templates/wx-*; a template must live two folders under the pack)
templates/wx-*/

# --- storyboard worked example: the board PNG, report.json and animatic.plan.json are committed; the rest is regenerated (storyboard/README.md) ---
storyboard/examples/*/animatic.mp4
storyboard/examples/*/animatic.wav
storyboard/examples/*/storyboard.pdf
storyboard/examples/*/storyboard.html
storyboard/examples/*/panels/
storyboard/examples/*/real/
