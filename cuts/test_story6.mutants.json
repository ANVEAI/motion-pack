{
 "file": "cuts/story6.py",
 "test": [
  "python3",
  "-m",
  "pytest",
  "-q",
  "-x",
  "cuts/test_story6.py"
 ],
 "timeout": 300,
 "mutants": [
  {
   "name": "gap range check disabled",
   "find": "p[\"gap_range_s\"][0] - 1e-9 <= gs <= p[\"gap_range_s\"][1] + 1e-9",
   "replace": "True"
  },
  {
   "name": "hold range check disabled",
