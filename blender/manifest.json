     "type": "float",
     "default": 0.45,
     "doc": "cascade start (s)"
    },
    "seal_at": {
     "type": "float",
     "default": 4.55,
     "doc": "lid seats (s); <= 0 = stay open"
    },
    "spread": {
     "type": "float",
     "default": 1.0,
     "doc": "offset scale (1 = the film's teardown)"
