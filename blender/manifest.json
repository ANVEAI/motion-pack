    },
    "az_end": {
     "type": "float",
     "default": 4.0,
     "doc": "camera azimuth at the end (deg)"
    },
    "lens": {
     "type": "float",
     "default": 85.0,
     "doc": "mm"
    },
    "fstop": {
     "type": "float",
     "default": 5.6,
     "doc": "aperture"
    },
    "fill": {
     "type": "float",
     "default": 0.0,
     "doc": "title width fill (0 = 0.74 wide / 0.86 tall)"
    },
    "lines": {
     "type": "str",
