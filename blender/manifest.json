  "blender/passReveal": {
   "name": "Render-pass reveal",
   "doc": "Wireframe -> x-ray -> clay -> full material on one model, each step a soft wipe; or one pass per plate (pass=...).",
   "use": "The 'how it is made' beat of an AI-builder or 3D-tool launch; a sketch-to-render reveal; per-pass plates for a wipe.",
   "avoid": "Implying a real product pipeline you do not have; a pass shown so briefly it reads as a glitch (< 0.6 s).",
   "loop": false,
   "defaults": {
    "seconds": 6.0,
    "size": [
     1920,
     1080
    ],
    "engine": "eevee"
   },
   "params": {
    "pass": {
     "type": "str",
     "default": "",
     "doc": "'' = timed progression; wire | xray | clay | full = hold that pass"
    },
    "steps": {
     "type": "list",
     "default": [
      0.9,
      2.1,
      3.3
     ],
     "doc": "start of each wipe (s): wire->xray | xray->clay | clay->full"
    },
    "wipe": {
     "type": "float",
     "default": 0.7,
     "doc": "seconds per wipe"
    },
    "orbit": {
     "type": "float",
     "default": 40.0,
     "doc": "camera orbit over the plate (deg)"
    },
    "az": {
     "type": "float",
     "default": 28.0,
     "doc": "camera azimuth at the start (deg)"
    },
    "el": {
     "type": "float",
     "default": 16.0,
     "doc": "camera elevation (deg)"
    },
    "lens": {
     "type": "float",
     "default": 60.0,
     "doc": "mm on a 24 mm vertical sensor"
    },
    "fstop": {
     "type": "float",
     "default": 8.0,
     "doc": "aperture"
    },
    "fill": {
     "type": "float",
     "default": 0.0,
     "doc": "model fill of the limiting frame side (0 = 0.62 wide / 0.86 tall)"
    },
    "wire_mm": {
     "type": "float",
     "default": 1.6,
