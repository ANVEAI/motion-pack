   "id": "blender/art.particleSwirl",
   "previews": [],
   "cli": "blender -b --factory-startup -P blender/run.py -- --recipe blender/art.particleSwirl --size 1920x1080 --fps 30 --seconds 6 --engine eevee --out out/art.particleSwirl"
  }
 },
 "library": {
  "lib/device.py": {
   "presets": [
    "matte-copper (matte black, copper-amber band)",
    "studio-white",
    "graphite-teal",
    "puck-violet"
   ],
   "api": "spec(preset, **over) -> build(D) -> set_band(D, K, level, ignite, hot), explode(D, K, t, t_open, t_seal)"
  },
  "lib/studio.py": {
   "api": "cyclorama, world_dark, world_reflection (camera-dark softbox dome), area, feathered_strip, product_rig (key strip / rim / accent / fill / floor pool, light-linked), move_key"
  },
  "lib/materials.py": {
   "library": [
    "matte_coat",
    "brushed_metal",
    "glass",
    "ceramic",
    "plastic",
    "chrome",
    "anodised",
    "emissive_band",
    "floor_polished",
    "emission",
    "pure_emission"
   ]
  },
  "lib/camera.py": {
   "moves": [
    "orbit",
    "turntable",
    "pushIn",
    "crane",
    "truck",
    "macroSlide",
    "dollyZoom",
    "whip",
    "rack",
    "breathe"
   ],
   "framing": "fit_dist (re-layout 16:9 / 9:16 / 1:1, never crop)"
  },
  "lib/render.py": {
   "presets": [
    "eevee_plate (fast plates)",
    "cycles_keyart (quality stills)"
   ]
  },
  "lib/title.py": {
   "api": "build(col, lines, font, weight, size, extrude, bevel, face_mat, side_mat)"
  },
  "lib/art.py": {
   "loops": [
    "liquid_chrome (metaballs)",
    "voxel_wave (geometry nodes)",
    "particle_swirl (geometry nodes)"
   ]
  },
  "lib/beats.py": {
   "api": "load(sidecar, fps, n, loop) -> envelope(B, f), rings(B, f)"
  }
 },
