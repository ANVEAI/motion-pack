  "lib/env.py": {
   "api": "sky_world (gradient + sun glow + stars), sun, point, haze_volume, eevee_volumes, cloud_sea, flare_card + face_card, flat_mat, ico, frustum (low-poly)"
  },
  "lib/diorama.py": {
   "scenes": [
    "lighthouse",
    "campfire",
    "island"
   ]
  }
