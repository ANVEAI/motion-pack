      0.02
     ],
     "doc": "palette 2 (linear)"
    },
    "c3": {
     "type": "color",
     "default": [
      0.55,
      0.7,
      1.0
     ],
     "doc": "palette 3 (linear)"
    },
    "el": {
     "type": "float",
     "default": 24.0,
     "doc": "camera elevation (deg)"
    },
    "lens": {
     "type": "float",
     "default": 50.0,
     "doc": "mm"
    },
    "fstop": {
     "type": "float",
     "default": 2.8,
