#!/bin/sh
# motion-pack / tools / mp: the shim for tools/mp.mjs (`mp list`, `mp new`, `mp render`, ...). Put it on PATH:  ln -s "$PWD/tools/mp" ~/.local/bin/mp
# Follows symlinks to find the pack, so a linked shim works from any folder.
f="$0"; while [ -L "$f" ]; do l="$(readlink "$f")"; case "$l" in /*) f="$l" ;; *) f="$(dirname "$f")/$l" ;; esac; done
exec node "$(cd "$(dirname "$f")" && pwd -P)/mp.mjs" "$@"
