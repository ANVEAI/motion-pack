{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ANVEAI/motion-pack/playbook/schema/style.schema.json",
  "title": "motion-pack playbook style",
  "description": "A named visual style: playbook/styles/<id>.json. A format says WHAT happens WHEN; a style says what it LOOKS and SOUNDS like, so the two are orthogonal: `mp plan <format> --style <id>` lays the style over the format. Every part a style names is an existing pack id (tools/check_ids.py resolves it), every palette passes skills/frame-design/scripts/contrast.py, and every format it lists exists. Validated by tools/playbook_build.py.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^//": {}
  },
  "required": [
    "id",
    "title",
    "title_zh",
    "line",
    "line_zh",
    "prompt",
    "prompt_zh",
    "essence",
    "not",
    "palette",
    "type",
    "motion",
    "transitions",
    "layers",
    "sound",
    "signature_features",
    "change_tiers",
    "formats",
    "recipes",
    "demo"
  ],
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "part": {
      "type": "string",
      "pattern": "^(transitions|sfx|music|type|layers|objects|blender|cuts|templates)/[A-Za-z0-9_./-]+$|^cam[23]d\\.[A-Za-z0-9_.]+$"
    },
    "reason": {
      "enum": [
        "EMOTION",
        "STORY",
        "RHYTHM",
        "ENERGY",
        "REVEAL",
        "PLACE"
      ]
    },
    "font": {
      "enum": [
        "Manrope",
        "IBM Plex Mono",
        "STIX Two Text"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "title_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "line": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120,
      "description": "the one-liner: what the style is, in plain words"
    },
    "line_zh": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
    },
    "prompt": {
      "type": "string",
      "minLength": 150,
      "maxLength": 250,
      "description": "the copy-ready style prompt a user pastes into their agent (150 to 250 characters)"
    },
    "prompt_zh": {
      "type": "string",
      "minLength": 40,
      "maxLength": 160
    },
    "essence": {
      "type": "string",
      "minLength": 40,
      "maxLength": 400,
      "description": "1 to 3 sentences: the idea the style serves"
    },
    "not": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "the nearest styles it must not drift into, each with the difference",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "style",
          "difference"
        ],
        "properties": {
          "style": {
            "type": "string",
            "minLength": 1
          },
          "difference": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logic",
        "paper",
        "ink",
        "accent",
        "muted",
        "contrast"
      ],
      "description": "role colours (frame-design names: paper = the ground, ink = text, accent = the one hue, muted = secondary text) and the WCAG ratios contrast.py measured; tools/playbook_build.py re-measures them",
      "properties": {
        "logic": {
          "type": "string",
          "minLength": 10
        },
        "paper": {
          "$ref": "#/$defs/hex"
        },
        "ink": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "muted": {
          "$ref": "#/$defs/hex"
        },
        "contrast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ink_on_paper",
            "accent_on_paper",
            "muted_on_paper"
          ],
          "properties": {
            "ink_on_paper": {
              "type": "number",
              "minimum": 4.5
            },
            "accent_on_paper": {
              "type": "number",
              "minimum": 3
            },
            "muted_on_paper": {
              "type": "number",
              "minimum": 4.5
            }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "text",
        "weight",
        "case",
        "presets"
      ],
      "properties": {
        "display": {
          "$ref": "#/$defs/font"
        },
        "text": {
          "$ref": "#/$defs/font"
        },
        "weight": {
          "type": "integer",
          "minimum": 200,
          "maximum": 900
        },
        "case": {
          "enum": [
            "sentence",
            "upper",
            "lower",
            "title"
          ]
        },
        "max_words_per_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "presets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "headline",
            "card",
            "end",
            "sub"
          ],
          "description": "type/<preset> ids by role (a template with a CONFIG.type block of these roles takes them)",
          "properties": {
            "headline": {
              "$ref": "#/$defs/part"
            },
            "card": {
              "$ref": "#/$defs/part"
            },
            "end": {
              "$ref": "#/$defs/part"
            },
            "sub": {
              "$ref": "#/$defs/part"
            }
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personality",
        "ease",
        "overshoot_max",
        "asl_s",
        "camera"
      ],
      "properties": {
        "personality": {
          "enum": [
            "calm",
            "precise",
            "playful",
            "energetic",
            "dramatic",
            "warm"
          ],
          "description": "the frame-design motion personality"
        },
        "ease": {
          "enum": [
            "enter",
            "hero",
            "exit",
            "move",
            "soft",
            "cam",
            "pop",
            "lin",
            "sine",
            "expoOut",
            "quint"
          ],
          "description": "the house easing class: a key of E in type/ease.js"
        },
        "overshoot_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.4,
          "description": "the largest overshoot a move may carry (fraction of its travel)"
        },
        "asl_s": {
          "$ref": "#/$defs/range",
          "description": "average shot length range in seconds"
        },
        "camera": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "move",
              "expresses"
            ],
            "properties": {
              "move": {
                "type": "string",
                "pattern": "^cam[23]d\\.[A-Za-z0-9_]+$"
              },
              "expresses": {
                "type": "string",
                "minLength": 4
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_reason",
        "banned"
      ],
      "properties": {
        "by_reason": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 2,
          "description": "the transition a boundary of this REASON uses (a template boundary keeps its reason; the style swaps the id)",
          "propertyNames": {
            "$ref": "#/$defs/reason"
          },
          "patternProperties": {
            "^[A-Z]+$": {
              "$ref": "#/$defs/part"
            }
          }
        },
        "banned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 5,
      "description": "the finishing overlay stack (layers/overlay.js kinds) a template with a CONFIG.layers list takes",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "params": {
            "type": "object"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "blend": {
            "type": "string"
          }
        }
      }
    },
    "look": {
      "$ref": "#/$defs/part",
      "description": "optional: the grade / look id (layers/look.* or layers/grade.*) for templates that grade footage"
    },
    "grain": {
      "$ref": "#/$defs/part",
      "description": "optional: the grain stock id (layers/grain.*)"
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "families",
        "sfx"
      ],
      "properties": {
        "bed": {
          "$ref": "#/$defs/part"
        },
        "alt_beds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          }
        },
        "sfx": {
          "type": "object",
          "additionalProperties": false,
          "description": "sound ids by role (a template with a CONFIG.sfx block of these roles takes them)",
          "properties": {
            "firstFrame": {
              "$ref": "#/$defs/part"
            },
            "card": {
              "$ref": "#/$defs/part"
            },
            "riser": {
              "$ref": "#/$defs/part"
            },
            "reveal": {
              "$ref": "#/$defs/part"
            },
            "sting": {
              "$ref": "#/$defs/part"
            }
          }
        },
        "foley": {
          "type": "string"
        }
      }
    },
    "signature_features": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "check"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 8
          },
          "check": {
            "type": "string",
            "pattern": "^(lint\\.[a-z0-9_.]+|review)$"
          }
        }
      }
    },
    "change_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe",
        "character",
        "identity"
      ],
      "description": "which fields a user may change freely (safe), changes that shift the character, and changes that make it another style (identity)",
      "properties": {
        "safe": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "character": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/part"
      },
      "description": "every pack part id the style and its demo use"
    },
    "apply": {
      "type": "object",
      "description": "optional per-template CONFIG overrides (templates/<id>: {CONFIG path: value}) beyond what the generic mapping sets",
      "additionalProperties": {
        "type": "object"
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "template",
        "seconds",
        "aspect",
        "status"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "pattern": "^templates/[a-z0-9-]+$"
        },
        "seconds": {
          "type": "number",
          "minimum": 8,
          "maximum": 12
        },
        "aspect": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:5"
          ]
        },
        "status": {
          "enum": [
            "rendered",
            "pending"
          ]
        },
        "preview": {
          "type": "string",
          "description": "the committed small preview (MP4 under 2 MB), relative to the pack"
        },
        "poster": {
          "type": "string",
          "description": "the committed still (JPEG), relative to the pack"
        },
        "release_asset": {
          "type": "string",
          "description": "the full-size demo's file name in the release assets"
        },
        "lint": {
          "type": "string",
          "description": "mp lint summary of the delivered demo"
        },
        "made_by": {
          "type": "string",
          "description": "who made the demo (model and agent), rounds and time: honesty.showcase labels"
        }
      }
    },
    "honesty": {
      "type": "string"
    }
  }
}
