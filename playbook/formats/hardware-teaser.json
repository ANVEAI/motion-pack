{
  "id": "hardware-teaser",
  "title": "Hardware teaser (device, wordless)",
  "use_when": "A device or physical product is teased before or at launch: light on an edge, details, one reveal, the name, a date. Tone over plot, one music cue.",
  "length_s": [
    6,
    30
  ],
  "//length": "House teaser 6-15 s (1:1 or 9:16); the one tier-A hardware film was 30 s; teasers in general 15-60 s.",
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "lead_aspect": "16:9",
  "template": "templates/hardware-teaser",
  "signals": {
    "keywords": [
      "device",
      "hardware",
      "gadget",
      "teaser",
      "coming soon",
      "pre-order",
      "reveal",
      "unboxing",
      "wearable",
      "box"
    ],
    "product_types": [
      "hardware",
      "device",
      "consumer electronics",
      "appliance",
      "wearable"
    ],
    "goals": [
      "awareness",
      "launch"
    ],
    "platforms": [
      "x",
      "reels",
      "shorts",
      "youtube"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.15
      ],
      "purpose": "light already moving on an edge at frame 0 (a band or edge sweep), or the product within 0-4 s; never a still silhouette for 1 s",
      "required": true,
      "text": {
        "max_words": 2
      },
      "sound": {
        "level": "quiet",
        "events": [
          "light_sweep_+11db_by_1s"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.first_change_by_frame6",
        "hook.hardware_shown_by_4s",
        "sound.quiet_open",
        "visual.hero_alone_bokeh"
      ]
    },
    {
      "id": "build",
      "at": [
        0.15,
        0.7
      ],
      "purpose": "macro details, one per cut (0.7-1.3 s); 2-3 word supers; the bass enters on a cut at about 25%",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "building",
        "events": [
          "bass_entry_on_cut",
          "tick_per_detail",
          "riser"
        ]
      },
      "rules": [
        "music.late_bass_entry",
        "type.phrases_2_to_5_words",
        "sound.riser_ends_frame_before_hit",
        "motion.camera_still_on_impacts",
        "visual.product_hero_frame_share"
      ]
    },
    {
      "id": "peak",
      "at": [
        0.7,
        0.8
      ],
      "purpose": "the reveal or peak: a silent beat, then one sub hit on the first full-product frame",
      "required": false,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "gap_then_hit",
        "events": [
          "one_sub_hit"
        ]
      },
      "rules": [
        "sound.one_reveal_hit",
        "sound.dropout_before_reveal",
        "music.dark_open_12db_under_drop"
      ]
    },
    {
      "id": "title",
      "at": [
        0.8,
        0.92
      ],
      "purpose": "the name (and \"and\" + a second product if any) on a flat brand-colour field, shape-mask wipe in",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "full",
        "events": [
          "sting_on_title"
        ]
      },
      "rules": [
        "visual.mark_in_world",
        "sound.hero_hit_over_bed"
      ]
    },
    {
      "id": "date",
      "at": [
        0.92,
        1.0
      ],
      "purpose": "the date or availability; slam to the last frame or a quiet tail",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "slam_or_tail",
        "events": [
          "slam_end"
        ]
      },
      "rules": [
        "sound.slam_end_hardware",
        "pacing.end_card_hold",
        "honesty.real_deadline_only"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -11,
      -7
    ],
    "quiet_open_s": [
      0.5,
      2
    ],
    "bass_entry_pct": [
      0.2,
      0.3
    ],
    "reveal_hit": "one sub hit",
    "tail": "slam",
    "bass_share": [
      0.4,
      0.61
    ],
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_cinematic_drone_loop8",
      "music/bed_suspense_pulse_loop8",
      "music/bed_deep_house_loop8"
    ],
    "mode": "music"
  },
  "hooks": [
    "light-from-dark",
    "cold-open",
    "pattern-break"
  ],
  "end_shapes": [
    "slam",
    "quiet-hold",
    "sting"
  ],
  "post": {
    "pattern": "One-line teaser the day before (optionally a 5 s frame); the teaser carries the withholding so the launch film can open on the product. Single post, \"Introducing X\" first line.",
    "rules": [
      "distribution.teaser_day_before",
      "distribution.first_line_archetype",
      "distribution.launch_window_utc"
    ]
  },
  "recommended_parts": {
    "hook": [
      "hw.edgeGlint",
      "sfx/hw/light_sweep",
      "sfx/hw/hum_loop",
      "layers/finish.premium-product",
      "layers/overlay.vignette",
      "cam3d.pushSlow"
    ],
    "build": [
      "hw.specCallout",
      "hw.dimensionLine",
      "sfx/hw/click_detent",
      "sfx/riser/noise_2bar",
      "sfx/hw/parts_seat",
      "cuts/sections/build_accelerate",
      "cam3d.orbit",
      "cam3d.dollyZoom"
    ],
    "peak": [
      "transitions/maskReveal",
      "sfx/hw/sub_hit",
      "sfx/hit/sub_drop"
    ],
    "title": [
      "transitions/maskReveal",
      "type/scaleSlam",
      "sfx/hit/brand_field_slam",
      "layers/overlay.brandField"
    ],
    "date": [
      "hw.dateCard",
      "card.releaseDate",
      "sfx/stinger/bump"
    ],
    "all": [
      "music/bed_cinematic_drone_loop8",
      "music/bed_suspense_pulse_loop8",
      "music/bed_deep_house_loop8"
    ]
  },
  "exemplars": [
