{
  "id": "short-film",
  "title": "Short film (protagonist, stake, quiet turn)",
  "use_when": "A story film: one named person with a concrete stake, one obstacle, the product (if any) as the quiet turn, a payoff that pays off the stake, an honesty label in frame.",
  "length_s": [
    45,
    180
  ],
  "//length": "The pattern runs 45-600 s; under 5 min carries one beat of change; feed cuts 12-15 s open on a 1.5-2.5 s flash-forward.",
  "aspects": [
    "16:9",
    "9:16"
  ],
  "lead_aspect": "16:9",
  "template": "templates/short-film",
  "signals": {
    "keywords": [
      "story",
      "short film",
      "character",
      "drama",
      "day in the life",
      "narrative",
      "scene",
      "office story",
      "ad film"
    ],
    "product_types": [
      "any",
      "brand",
      "b2b"
    ],
    "goals": [
      "entertain",
      "awareness"
    ],
    "platforms": [
      "youtube",
      "shorts",
      "reels",
      "x"
    ]
  },
  "beats": [
    {
      "id": "coldopen",
      "at": [
        0,
        0.08
      ],
      "purpose": "an image that asks a question; room tone and one diegetic sound",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "room_tone",
        "events": [
          "one_diegetic_sound"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.feed_flash_forward",
        "sound.ambience_floor",
        "story.short_film_one_shift"
      ]
    },
    {
      "id": "want",
      "at": [
        0.08,
        0.24
      ],
      "purpose": "the world and the want; the stake on screen by the end of this beat; the score waits",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "room_tone",
        "events": [
          "room_tone_under_scene"
        ]
      },
      "rules": [
        "story.protagonist_with_stake",
        "story.through_line_not_vignettes",
        "visual.concrete_artefacts",
        "pacing.asl_short_film"
      ]
    },
    {
      "id": "obstacle",
      "at": [
        0.24,
        0.5
      ],
      "purpose": "one obstacle only; foley on every contact; tension in the room tone",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "tense",
        "events": [
          "foley_per_contact"
        ]
      },
      "rules": [
        "story.one_problem_one_solution",
        "pacing.same_scale_run",
        "sound.split_edits"
      ]
    },
    {
      "id": "turn",
      "at": [
        0.5,
        0.6
      ],
      "purpose": "the turn at 50-60%: 200-400 ms of silence before it; the product arrives quietly and never explains itself",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "silence_then_score",
        "events": [
          "silence_200-400ms",
          "score_on_emotion"
        ]
      },
      "rules": [
        "story.short_film_turn_window",
        "sound.silence_before_turn",
        "story.product_quiet_turn",
        "story.one_turn_in_window"
      ]
    },
    {
      "id": "consequence",
      "at": [
        0.6,
        0.84
      ],
      "purpose": "the score carries the reaction; hold each emotional shot until it lands, then 6-12 frames longer",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "score",
        "events": [
          "score_carries"
        ]
      },
      "rules": [
        "pacing.asl_short_film",
        "pacing.reaction_hold"
      ]
    },
    {
      "id": "resolution",
      "at": [
        0.84,
        0.94
      ],
      "purpose": "the payoff pays off the opening stake visibly (the bill reads zero, the chair is filled), never a cheer or a logo",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "score_resolves",
        "events": []
      },
      "rules": [
        "story.payoff_pays_stake",
        "story.payoff_after_turn",
        "honesty.label_hold_2s"
      ]
    },
    {
      "id": "tag",
      "at": [
        0.94,
        1.0
      ],
      "purpose": "a tag or credit of at most 6 s; dip to black into credits; a quiet tail",
      "required": false,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "quiet",
        "events": [
          "quiet_tail"
        ]
      },
      "rules": [
        "delivery.lra_short_film"
      ]
    }
  ],
  "sound_shape": {
    "room_tone_lufs": -48,
    "turn_silence_s": [
      0.2,
      0.4
    ],
    "score_enters": "on emotion (scene two), not on action",
    "tail": "quiet-hold",
    "lra_lu": [
      10,
      15
    ],
    "lra_note": "conflicts with the 10 LU short-form ceiling: declare the film as short-film so ears uses the long-form range",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_cinematic_drone_loop8",
      "music/bed_acoustic_folk_pluck_loop8",
      "music/bed_ambient_pad_loop8"
    ],
    "mode": "vo"
  },
  "hooks": [
    "cold-open",
    "in-medias-res",
    "curiosity-gap"
  ],
  "end_shapes": [
    "quiet-hold"
  ],
  "post": {
    "pattern": "A 12-15 s feed cut with a flash-forward hook plus the full film; caption line 1 the stake; films beat chats on Shorts (median 44 vs 4 views).",
    "rules": [
      "distribution.film_to_chat_ratio",
      "distribution.caption_stake_first_125",
      "platform.ai_label_youtube",
      "platform.ai_label_instagram_on"
    ]
  },
  "recommended_parts": {
    "coldopen": [
      "sfx/amb/room_tone",
      "sfx/amb/office",
      "layers/look.film-drama",
      "layers/grain.film35"
    ],
    "want": [
