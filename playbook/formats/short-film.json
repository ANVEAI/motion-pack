      "sfx/device/phone_buzz",
      "cuts/split/J",
      "cuts/split/L"
    ],
    "turn": [
      "sfx/hw/led_on",
      "sfx/lift/inhale"
    ],
    "consequence": [
      "music/bed_cinematic_drone_cine30"
    ],
    "tag": [
      "transitions/dip",
      "credits.roll"
    ],
    "all": [
      "music/bed_cinematic_drone_loop8",
      "music/bed_acoustic_folk_pluck_loop8",
      "music/bed_ambient_pad_loop8"
    ]
  },
