{
  "id": "trailer",
  "title": "Trailer (three-act, title, date)",
  "use_when": "A film, series, game or big release trailer: world, turn, wall montage, silence, title, button, date. Tone and escalation over explanation.",
  "length_s": [
    60,
    150
  ],
  "//length": "Corpus mean 122.8 s over 6,926 trailers; a voluntary 150 s cap; 30 s and 15 s cut-downs from the same plan.",
  "aspects": [
    "16:9",
    "9:16"
  ],
  "lead_aspect": "16:9",
  "template": "templates/trailer",
  "signals": {
    "keywords": [
      "trailer",
      "teaser trailer",
      "film",
      "series",
      "season",
      "game",
      "premiere",
      "coming",
      "release date",
      "movie"
    ],
    "product_types": [
      "film",
      "series",
      "game",
      "event",
      "book"
    ],
    "goals": [
      "awareness",
      "launch",
      "entertain"
    ],
    "platforms": [
      "youtube",
      "x",
      "reels"
    ]
  },
  "beats": [
    {
      "id": "coldopen",
      "at": [
        0,
        0.1
      ],
      "purpose": "near-silent: one line of dialogue or one image alone; one hit out of it",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "quiet",
        "events": [
          "one_hit_out"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "sound.quiet_open",
        "hook.first_change_by_frame6"
      ]
    },
    {
      "id": "act1",
      "at": [
        0.1,
        0.3
      ],
      "purpose": "the world: holds of 6-8 beats a shot, sparse drone, copy cards on soft whooshes",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "low",
        "events": [
          "drone"
        ]
      },
      "rules": [
        "pacing.trailer_accelerate",
        "story.trailer_arc"
      ]
    },
    {
      "id": "act2",
      "at": [
        0.3,
        0.65
      ],
      "purpose": "the turn: shots halve to 4 -> 2 beats, percussion enters, a braam every other bar; a pull-out or silence before the key line",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "rising",
        "events": [
          "braam_every_2_bars"
        ]
      },
      "rules": [
        "pacing.trailer_accelerate",
        "sound.hit_hierarchy_spacing",
        "sound.no_doubled_score_hits"
      ]
    },
    {
      "id": "act3",
      "at": [
        0.65,
        0.88
      ],
      "purpose": "the wall: 2 -> 1 -> half-beat shots (2-4 cuts/s at 120 BPM), riser to hit, sub impacts on cuts to black",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "full",
        "events": [
          "braam_every_bar",
          "riser_ends_frame_before_hit"
        ]
      },
      "rules": [
        "pacing.trailer_accelerate",
        "sound.riser_ends_frame_before_hit",
        "motion.flash_limit"
      ]
    },
    {
      "id": "silence_title",
      "at": [
        0.88,
        0.94
      ],
      "purpose": "the wall stops dead; 1-3 s of declared silence (a faint ring at most), then the title on the hit",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "silence_then_hit",
        "events": [
          "hit_silence_hit"
        ]
      },
      "rules": [
        "sound.trailer_hit_silence_hit",
        "visual.declare_planned_black",
        "sound.planned_quiet_maxima"
      ]
    },
    {
      "id": "button",
      "at": [
        0.94,
        0.97
      ],
      "purpose": "one last line or gag over near-silence",
      "required": false,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "near_silent",
        "events": [
          "sting_button"
        ]
      },
      "rules": []
    },
    {
      "id": "date",
      "at": [
        0.97,
        1.0
      ],
      "purpose": "the release card and billing block; a quiet tail or one low hit",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "quiet",
        "events": [
          "quiet_tail"
        ]
      },
      "rules": [
        "story.cta_window",
        "honesty.real_deadline_only"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -25,
      -15
    ],
    "quiet_open_s": [
      1,
      2
    ],
    "title_silence_s": [
      1,
      3
    ],
    "tail": "quiet-hold",
    "tail_db": -35,
    "bass_share": [
      0.5,
      0.61
    ],
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_trailer_arc",
      "music/bed_trailer_drama",
      "music/bed_trailer_thriller",
      "music/bed_trailer_scifi"
    ],
    "mode": "music"
  },
  "hooks": [
    "cold-open",
    "in-medias-res",
    "provocative-line"
  ],
  "end_shapes": [
    "quiet-hold",
    "sting"
  ],
  "post": {
    "pattern": "Native upload of the full cut; a 30 s and a 15 s cut-down from the same plan; the date in the first line.",
    "rules": [
      "story.cutdown_trailer_order",
      "platform.native_upload_x",
      "distribution.first_line_archetype"
    ]
  },
  "recommended_parts": {
    "coldopen": [
      "card.production",
      "sfx/trailer/boom_hit",
      "sfx/amb/room_tone"
    ],
    "act1": [
      "title.trailerThin",
      "sfx/trailer/drone_dark_loop",
      "sfx/trailer/whoosh_by",
      "cuts/trailer/accelerate3Act"
    ],
    "act2": [
      "title.trailerSlab",
      "sfx/trailer/braam_short",
      "sfx/trailer/reverse_swell_2s"
    ],
    "act3": [
      "transitions/flash",
      "transitions/cut",
      "sfx/trailer/riser_4s",
      "sfx/trailer/metal_hit",
      "cuts/sections/build_accelerate"
    ],
    "silence_title": [
      "title.trailerGlow",
      "sfx/trailer/hit_silence_hit",
      "sfx/trailer/ring_tinnitus",
      "sfx/trailer/hit_title",
      "cuts/trailer/hitSilenceHit"
    ],
    "button": [
      "sfx/trailer/sting_button"
    ],
    "date": [
      "card.releaseDate",
      "credits.billingBlock"
    ],
    "all": [
      "music/bed_trailer_arc",
      "music/bed_trailer_drama",
      "music/bed_trailer_thriller",
      "music/bed_trailer_scifi"
    ]
  },
