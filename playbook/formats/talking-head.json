    {
      "id": "th-oneTake-80",
      "label": "founder to camera, one take with giant words, 80 s (craft)",
      "grade": "craft",
      "tier": "claim-driven (283x, 0.27% likes): craft only",
      "length_s": 80,
      "aspect": "16:9",
      "cuts": 0,
      "beats": [
        {
          "at": [
            0,
