{
  "id": "talking-head",
  "title": "Talking head (retention edit)",
  "use_when": "A person speaking to camera: a founder update, a tip, a clip from a talk. Cut per sentence, captions on every line, B-roll per idea, punch-ins on key claims.",
  "length_s": [
    20,
    90
  ],
  "//length": "Founder films on X and LinkedIn 60-90 s; feed clips 20-60 s.",
  "aspects": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "lead_aspect": "9:16",
  "template": "templates/talking-head",
  "signals": {
    "keywords": [
      "founder",
      "talk",
      "to camera",
      "interview",
      "tip",
      "update",
      "vlog",
      "podcast",
      "speaker",
      "webinar clip"
    ],
    "product_types": [
      "any",
      "personal brand",
      "b2b"
    ],
    "goals": [
      "awareness",
      "explain",
      "teach",
      "launch"
    ],
    "platforms": [
      "linkedin",
      "x",
      "reels",
      "shorts"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.1
      ],
      "purpose": "the sharpest line first, mid-sentence on frame 0; key phrase as large captions; no music for the first 8-12 s of a founder film",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "voice",
        "events": [
          "voice_frame_0"
        ]
      },
      "rules": [
        "hook.speak_from_frame0_on_camera",
        "hook.first_sound_by_frame3",
        "pacing.founder_open",
        "honesty.verbatim_quote_gate",
        "type.caption_style"
      ]
    },
    {
      "id": "context",
      "at": [
        0.1,
        0.25
      ],
      "purpose": "the setup or the question being answered; a lower third (name and role only)",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "voice_low_bed",
        "events": [
          "duck_9db"
        ]
      },
      "rules": [
        "type.lower_third_spec",
        "sound.duck_depth",
        "sound.speech_over_music"
      ]
    },
    {
      "id": "body",
      "at": [
        0.25,
        0.85
      ],
      "purpose": "cut per sentence or clause (2.5-5 s), silences over 0.5 s cut with a 120 ms breath kept; B-roll covers 35-50% in 1.2-3 s inserts that lead the line by 150 ms; a punch-in at most once per 4 s",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "voice",
        "events": [
          "broll_leads_150ms",
          "punch_in_max_1_per_4s"
        ]
      },
      "rules": [
        "pacing.asl_talking_head",
        "pacing.talking_head_cut_rules",
        "motion.punch_in_cadence",
        "sound.talking_head_sfx_under_voice",
        "sound.room_tone_under_cuts",
        "type.captions_every_sentence",
        "type.no_text_box_overlap",
        "sound.vo_wpm"
      ]
    },
    {
      "id": "button",
      "at": [
        0.85,
        1.0
      ],
      "purpose": "the punchline lands dry, a 450 ms face hold, then the ask or URL",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "dry",
        "events": [
          "beat_hold_450ms"
        ]
      },
      "rules": [
        "pacing.end_card_hold",
        "distribution.no_spoken_cta_builders"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "voice from frame 0",
    "duck_db_min": 9,
    "speech_over_music_db": 10,
    "vo_wpm": [
      110,
      175
    ],
    "tail": "dry | quiet-hold",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_lofi_warm_loop8",
      "music/bed_ambient_pad_loop8",
      "music/bed_documentary_marimba_loop8"
    ],
    "mode": "vo"
  },
  "hooks": [
    "founder-to-camera",
    "provocative-line",
    "claim-or-question",
    "in-medias-res"
  ],
  "end_shapes": [
    "quiet-hold",
    "dry"
  ],
  "post": {
    "pattern": "Native upload with burned captions on X and LinkedIn; the claim and the link in the post copy, not spoken.",
    "rules": [
      "platform.burn_captions_muted",
      "distribution.link_in_first_comment",
      "distribution.no_spoken_cta_builders"
    ]
  },
  "recommended_parts": {
    "hook": [
      "caption.oneWordSlam",
      "caption.speakerTag",
      "cuts/talking_head/punch_in"
    ],
    "context": [
      "lowerThird.cleanBar",
      "cuts/talking_head/autocut"
    ],
    "body": [
      "sfx/amb/room_tone",
      "sfx/ui/pop",
      "cuts/talking_head/autocut",
      "cuts/talking_head/reframe_alternate",
      "cuts/split/broll_lead",
      "cuts/talking_head/punch_in",
      "cam2d.punchCadence"
    ],
    "button": [
      "title.endScreen",
      "cuts/talking_head/beat_hold"
    ],
    "all": [
      "music/bed_lofi_warm_loop8",
      "music/bed_ambient_pad_loop8",
      "music/bed_documentary_marimba_loop8"
    ]
  },
  "exemplars": [
    {
