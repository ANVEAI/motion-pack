    {
      "id": "th-offer-12",
      "label": "single locked shot with an offer, 12.1 s (ad-native, not a recipe)",
      "grade": "inferred",
      "tier": "B (boosted-looking, 1,344x at 0.015% likes)",
      "length_s": 12.1,
      "aspect": "16:9",
      "cuts": 1,
      "beats": [
        {
          "at": [
            0,
            0.21
          ],
          "purpose": "direct address from 0.0 s, captions from 0.5 s, the offer said by 2.5 s",
          "text": "captions",
          "sound": ""
        },
        {
          "at": [
            0.21,
            1.0
          ],
          "purpose": "one locked shot, one cut at the end",
          "text": "",
          "sound": "tail -0.9 dB"
        }
      ],
      "quiet_open_db": -4.2,
      "end_shape": "dry",
      "sources": [
        {
          "doc": "private:research/reference-round7-2026-10.md",
          "locator": "Per-film craft: the other 12 films (film 14)"
        }
      ],
      "vo_wpm": 105,
      "notes": "The reach came from the boosted-looking shape, not the craft (hook.no_offer_as_hook).",
      "quiet_tail_db": -0.9,
      "cuts_per_min": 5.0
    }
  ],
