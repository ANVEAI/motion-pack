{
  "id": "explainer",
  "title": "Explainer (question, wrong model, reframe, proof, so-what)",
  "use_when": "How something works or why it matters: one idea, one diagram built step by step, a voice or type leading, one real example.",
  "length_s": [
    30,
    90
  ],
  "//length": "The pattern runs 30-600 s; short-form explainers 30-90 s; long ones re-hook around minutes 3 and 6.",
  "aspects": [
    "16:9",
    "9:16"
  ],
  "lead_aspect": "16:9",
  "template": "templates/explainer-diagram",
  "signals": {
    "keywords": [
      "how it works",
      "explain",
      "why",
      "what is",
      "under the hood",
      "diagram",
      "walkthrough",
      "architecture",
      "concept"
    ],
    "product_types": [
      "technology",
      "science",
      "api",
      "model",
      "process",
      "finance"
    ],
    "goals": [
      "explain",
      "teach",
      "awareness"
    ],
    "platforms": [
      "youtube",
      "linkedin",
      "x"
    ]
  },
  "beats": [
    {
      "id": "question",
      "at": [
        0,
        0.1
      ],
      "purpose": "the question the viewer has, over a diagram already drawing; never a definition; a planned quiet open is fine",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "quiet",
        "events": [
          "one_sound_on_question"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.text_by_0_3s",
        "hook.first_sound_by_frame3",
        "sound.quiet_open",
        "story.explainer_beats"
      ]
    },
    {
      "id": "wrongmodel",
      "at": [
        0.1,
        0.3
      ],
      "purpose": "the simple wrong model the viewer holds, shown first",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "low",
        "events": [
          "diagram_ticks"
        ]
      },
      "rules": [
        "story.explainer_wrong_model_first",
        "type.no_redundant_on_screen_text"
      ]
    },
    {
      "id": "reframe",
      "at": [
        0.3,
        0.65
      ],
      "purpose": "the right model on one canvas, one node per named idea (dim the rest), one step per sentence inside speech gaps every 3-6 s; one dive into the hardest box; a complication (\"but...\") at 40-50%",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "body",
        "events": [
          "step_in_speech_gap",
          "soft_hit_on_reframe"
        ]
      },
      "rules": [
        "story.diagram_in_vo_gaps",
        "story.explainer_complication",
        "pacing.asl_voice_led",
        "pacing.continuous_ok",
        "sound.duck_depth",
        "sound.speech_over_music",
        "sound.vo_wpm",
        "type.captions_every_sentence"
      ]
    },
    {
      "id": "proof",
      "at": [
        0.65,
        0.85
      ],
      "purpose": "one real example traced through the model; every number sourced in frame",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "one_hit_on_example"
        ]
      },
      "rules": [
        "honesty.digit_needs_source",
        "honesty.chart_source_in_frame",
        "honesty.chart_zero_baseline",
        "story.one_running_example"
      ]
    },
    {
      "id": "sowhat",
      "at": [
        0.85,
        1.0
      ],
      "purpose": "what to do now, one line; the end card held 2-9 s on a declared quiet hold",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "quiet_hold",
        "events": [
          "quiet_hold"
        ]
      },
      "rules": [
        "sound.quiet_hold_ending",
        "pacing.end_card_hold",
        "story.cta_window",
        "sound.planned_quiet_maxima"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -39,
      -9
    ],
    "quiet_open_s": [
      1,
      2
    ],
    "tail": "quiet-hold",
    "tail_hold_s": [
      2,
      9
    ],
    "bass_share": [
      0.2,
      0.36
    ],
    "vo_wpm": [
      110,
      175
    ],
    "duck_db_min": 9,
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_corporate_bright_explainer60",
      "music/bed_documentary_marimba_loop8",
      "music/bed_ambient_pad_loop8"
    ],
    "mode": "vo"
  },
  "hooks": [
    "claim-or-question",
    "curiosity-gap",
    "problem-agitate"
  ],
  "end_shapes": [
    "quiet-hold"
  ],
  "post": {
    "pattern": "Single post; a chaptered long cut on YouTube, the 30 s cut-down (question, reframe, so-what) for feeds.",
    "rules": [
      "story.cutdown_launch_order",
      "distribution.title_stake_first",
      "platform.burn_captions_muted"
    ]
  },
  "recommended_parts": {
    "question": [
      "type/maskRise",
      "title.hookCard",
      "diagram.flow",
      "sfx/ui/highlight_draw"
    ],
    "wrongmodel": [
      "diagram.graph",
      "layout.degradingDiagram",
      "sfx/ui/tick"
    ],
    "reframe": [
      "diagram.flow",
      "callout.highlightBox",
      "callout.connectorLabel",
      "sfx/ui/tick",
      "sfx/hit/soft",
      "cuts/story/diagramWalkthrough",
      "cam2d.scaleDive",
      "cam2d.push2d"
    ],
    "proof": [
      "chart.bar",
      "chart.sourceFooter",
      "counter.hero",
      "sfx/hit/soft"
    ],
    "sowhat": [
      "title.takeaway",
      "cuts/sections/breath_out"
    ],
    "all": [
      "music/bed_corporate_bright_explainer60",
      "music/bed_documentary_marimba_loop8",
      "music/bed_ambient_pad_loop8"
    ]
  },
