{
  "id": "proof-clip",
  "title": "Proof clip (one claim, wordless)",
  "use_when": "One claim proved by one physical graphic or one run: before/after on the same footage, one chart, one escalating input ladder. Thread children of a launch, or a stand-alone saves post.",
  "length_s": [
    13,
    20
  ],
  "//length": "Thread proof clips ran 12.9-15.0 s; saves-strong silent loops 14.5-16 s; tier-A single-UI ladders run up to 60 s (exemplars).",
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "lead_aspect": "16:9",
  "template": "templates/proof-film",
  "signals": {
    "keywords": [
      "proof",
      "benchmark",
      "before and after",
      "vs",
      "faster",
      "fixed",
      "one feature",
      "show it works",
      "demo clip",
      "comparison"
    ],
    "product_types": [
      "saas",
      "ai tool",
      "developer tool",
      "api",
      "model"
    ],
    "goals": [
      "proof",
      "launch",
      "sell"
    ],
    "platforms": [
      "x",
      "linkedin",
      "reels",
      "shorts"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.1
      ],
      "purpose": "the before state named by a corner state chip on frame 0; a \"sound on\" pill outline on frame 0, solid at 0.5 s, gone by 1.5 s",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "body",
        "events": [
          "sound_on_pill"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.first_change_by_frame6",
        "hook.sound_on_pill",
        "story.state_chip_flip_share",
        "hook.first_sound_by_frame3"
      ]
    },
    {
      "id": "before",
      "at": [
        0.1,
        0.42
      ],
      "purpose": "the problem plays and is audible: one claim, one physical graphic (a lane going flat, blocks merging, a slider)",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "body",
        "events": [
          "problem_audible"
        ]
      },
      "rules": [
        "story.proof_clip_one_claim",
        "sound.mute_open_as_before",
        "pacing.new_state_every_3s",
        "honesty.compressed_demo_label"
      ]
    },
    {
      "id": "flip",
      "at": [
        0.42,
        0.5
      ],
      "purpose": "the chip flips (colour flash, new label, tick) and the sound swaps on that exact frame",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "swap",
        "events": [
          "swap_on_flip_frame"
        ]
      },
      "rules": [
        "story.ab_replay",
        "story.state_chip_flip_share",
        "sound.hit_on_f_plus_1"
      ]
    },
    {
      "id": "after",
      "at": [
        0.5,
        0.88
      ],
      "purpose": "the same footage replayed with the fix, level-matched to the before within 1 dB so only the claim changes",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "body",
        "events": [
          "halves_within_1db"
        ]
      },
      "rules": [
        "story.ab_replay",
        "honesty.same_input_progress",
        "honesty.digit_needs_source"
      ]
    },
    {
      "id": "end",
      "at": [
        0.88,
        1.0
      ],
      "purpose": "a genre payoff (a story beat or a genre title card) or a hard stop on the fixed state; never a CTA card",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "slam_or_decay",
        "events": [
          "slam_or_decay_-26db"
        ]
      },
      "rules": [
        "story.proof_clip_genre_end",
        "delivery.clean_tail"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "no quiet open: the problem must be audible from frame 0 (or a true-silence \"before\" under a mute chip, sound.mute_open_as_before)",
    "flip_pct": [
      0.4,
      0.45
    ],
    "halves_match_db": 1.0,
    "tail": "slam | decay",
    "tail_db_decay": -26,
    "bass_share": [
      0.2,
      0.36
    ],
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_suspense_tick_loop8",
      "music/bed_tech_pulse_loop8",
      "music/bed_ambient_pad_loop8"
    ],
    "mode": "continuous",
    "silent_loop_ok_s": 16
  },
  "hooks": [
    "payoff-first",
    "claim-or-question",
    "live-demo",
    "pattern-break"
  ],
  "end_shapes": [
    "slam",
    "decay",
    "genre-card",
    "silent-loop"
  ],
  "post": {
    "pattern": "Thread child posted about 2 min after the hero: \"N.\" + the problem name, a one-line claim, a paragraph on the old workaround and its cost, a fix paragraph ending in the benefit. Stand-alone: one saves post; judge by bookmarks at 48 h.",
    "rules": [
      "distribution.numbered_clip_copy",
      "distribution.hero_plus_numbered_thread",
      "distribution.judge_by_saves",
      "distribution.read_windows"
    ]
  },
  "recommended_parts": {
    "hook": [
      "type/blurIn",
      "ui.stateChip",
      "caption.soundOnPill",
      "sfx/ui/toggle_on"
    ],
    "before": [
      "ui.appWindow",
      "ui.waveform",
      "ui.costTicker",
      "sfx/ui/error",
      "sfx/device/loading_tick"
    ],
    "flip": [
      "transitions/maskReveal",
      "transitions/lumaWipe",
      "ui.approvalSlider",
      "ui.beforeAfterSplit",
      "sfx/ui/success",
      "sfx/tx/mask_reveal",
      "cuts/story/abReplay"
    ],
    "after": [
      "process.beforeAfter",
      "chart.sourceFooter"
    ],
    "end": [
      "card.scene",
      "sfx/stinger/cut_to_black"
    ],
    "all": [
      "music/bed_suspense_tick_loop8",
      "music/bed_tech_pulse_loop8",
      "music/bed_ambient_pad_loop8"
    ]
  },
