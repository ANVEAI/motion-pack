{
  "id": "screen-life",
  "title": "Screen-life (the story on one screen)",
  "use_when": "A story told entirely on a desktop or phone screen: typing, deleting, a message arriving, the product as proof on the same screen. Short UI loops (12-13 s) or story shorts (40-50 s).",
  "length_s": [
    12,
    50
  ],
  "//length": "Tier-A UI loops 12.6-12.8 s (3.2 s units); the pack-built screen-life story ran 44.5-47.7 s.",
  "aspects": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "lead_aspect": "9:16",
  "template": "templates/saas-feature-drop",
  "//template": "No screen-life template exists; saas-feature-drop (UI windows, cursor, typed text) is the closest.",
  "signals": {
    "keywords": [
      "screen",
      "desktop",
      "laptop",
      "typing",
      "message",
      "notification",
      "inbox",
      "screen-life",
      "phone screen",
      "dm"
    ],
    "product_types": [
      "saas",
      "app",
      "ai tool",
      "security",
      "productivity"
    ],
    "goals": [
      "awareness",
      "explain",
      "entertain"
    ],
    "platforms": [
      "reels",
      "shorts",
      "x"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.12
      ],
      "purpose": "a typed pain line on frame 0 with a visible caret; sound on by 0.25 s, one key sound per keystroke",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "body",
        "events": [
          "key_per_keystroke"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "type.typing_is_the_clock",
        "hook.text_by_0_3s",
        "sound.one_sound_per_ui_action"
      ]
    },
    {
      "id": "setup",
      "at": [
        0.12,
        0.43
      ],
      "purpose": "the world on the screen: windows, a notification, the stake (a person waiting, a file, a deadline)",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "drop_out_before_new_unit"
        ]
      },
      "rules": [
        "story.protagonist_with_stake",
        "pacing.new_state_every_3s",
        "visual.tall_ui_zoom_to_region"
      ]
    },
    {
      "id": "turn",
      "at": [
        0.43,
        0.6
      ],
      "purpose": "the turn on screen: a typed answer deleted, a message not sent, a choice; silence or a dip before it",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "dip",
        "events": [
          "silence_before_turn"
        ]
      },
      "rules": [
        "story.one_turn_in_window",
        "sound.silence_before_turn",
        "sound.silence_cues_action"
      ]
    },
    {
      "id": "proof",
      "at": [
        0.6,
        0.85
      ],
      "purpose": "the proof on the same screen (a log, a table, a result), real or labelled; one new state per 3 s unit on a downbeat",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "hit_on_new_state"
        ]
      },
      "rules": [
        "honesty.placeholder_labelled_in_frame",
        "visual.real_ui_composited",
        "honesty.never_invent_assets",
        "story.payoff_pays_stake"
      ]
    },
    {
      "id": "end",
      "at": [
        0.85,
        1.0
      ],
      "purpose": "the end line on black or the screen settling; the honesty label repeated; quiet tail or slam",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "decay",
        "events": []
      },
      "rules": [
        "pacing.end_card_hold",
        "honesty.label_hold_2s",
        "delivery.ceiling_for_dense_clicks"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "key sounds from frame 0; a foley-only open needs pre-music cues lifted over room tone",
    "unit_s": [
      3.0,
      3.2
    ],
    "tail": "decay | slam",
    "master_ceiling_dbtp": -2.0,
    "master_ceiling_note": "click-dense typing mixes need a -2.0 to -3.0 dBTP ceiling to read <= -1.0 after AAC (delivery.ceiling_for_dense_clicks)",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_suspense_tick_loop8",
      "music/bed_lofi_warm_loop8",
      "music/bed_tech_pulse_loop8"
    ],
    "mode": "continuous"
  },
  "hooks": [
    "in-medias-res",
    "curiosity-gap",
    "problem-agitate"
  ],
  "end_shapes": [
    "decay",
    "slam",
    "quiet-hold"
  ],
  "post": {
    "pattern": "Single post; caption line 1 the stake; title stake-first; AI and demo labels set per platform.",
    "rules": [
      "distribution.caption_stake_first_125",
      "distribution.title_stake_first",
      "platform.ai_label_instagram_on",
      "platform.ai_disclosure_in_text"
    ]
  },
  "recommended_parts": {
    "hook": [
      "type/typewriter",
      "ui.promptBar",
      "device.laptop",
      "sfx/ui/type_key",
      "sfx/device/keyboard_mech_soft"
    ],
    "setup": [
      "ui.appWindow",
      "social.notification",
      "ui.cursorJourney",
      "sfx/device/notify_soft",
      "sfx/ui/click",
      "cam2d.punchCadence"
    ],
    "turn": [
      "sfx/ui/toggle_off",
      "sfx/device/message_sent"
    ],
    "proof": [
      "ui.dataTable",
      "ui.stateChip",
      "callout.uiHighlight",
      "sfx/ui/success"
    ],
    "end": [
      "title.endScreen"
    ],
    "all": [
      "music/bed_suspense_tick_loop8",
      "music/bed_lofi_warm_loop8",
      "music/bed_tech_pulse_loop8"
    ]
  },
