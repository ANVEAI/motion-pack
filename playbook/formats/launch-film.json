{
  "id": "launch-film",
  "title": "Launch film (hero)",
  "use_when": "A product or release gets one hero film: a stake or claim, one turn, the product acting, one sourced proof, the name, the URL. Type-led or VO-led; a founder on camera is a variant (see exemplars).",
  "length_s": [
    30,
    38
  ],
  "//length": "Tier-A startup product films ran 30-38 s (3 of 4, round 7); people-led documentaries run 107-185 s (use the documentary format); nothing tier-A sat between 60 and 100 s.",
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "lead_aspect": "16:9",
  "template": "templates/saas-launch",
  "signals": {
    "keywords": [
      "launch",
      "introducing",
      "announce",
      "release",
      "now available",
      "out today",
      "hero film",
      "product video",
      "v1",
      "v2",
      "ship"
    ],
    "product_types": [
      "saas",
      "ai tool",
      "app",
      "developer tool",
      "platform",
      "api",
      "open-source tool"
    ],
    "goals": [
      "launch",
      "awareness"
    ],
    "platforms": [
      "x",
      "linkedin",
      "youtube",
      "web"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.06
      ],
      "purpose": "the stake or claim on frame 0, already moving; one calm field, 1-3 words on frame 0, the full line by 1-2 s",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "quiet",
        "events": [
          "first_sound_by_0.25s",
          "text_by_1s"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.first_change_by_frame6",
        "hook.frame0_subject_contrast",
        "sound.quiet_open",
        "hook.text_by_0_3s",
        "hook.type_line_on_calm_field",
        "type.read_line_max_words",
        "hook.three_variants_one_body"
      ]
    },
    {
      "id": "problem",
      "at": [
        0.06,
        0.25
      ],
      "purpose": "the pain as one concrete scene inside a tool the viewer already uses; UI ticks and texture only, no kick or bass",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "thin",
        "events": [
          "one_sound_per_ui_action",
          "no_bass"
        ]
      },
      "rules": [
        "story.pain_in_familiar_tool",
        "music.late_drop_on_turn",
        "sound.one_sound_per_ui_action",
        "story.degrading_problem_ladder",
        "story.one_problem_one_solution",
        "pacing.static_hold_max"
      ]
    },
    {
      "id": "turn",
      "at": [
        0.25,
        0.3
      ],
      "purpose": "one turn line (a question or reframe) at about 30%; 0.3-0.5 s of true silence before it; the bass enters on it",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "gap_then_full",
        "events": [
          "silence_0.3-0.5s_before",
          "bass_entry"
        ]
      },
      "rules": [
        "story.one_turn_in_window",
        "story.turn_at_30pct",
        "sound.silence_before_turn",
        "music.late_bass_entry",
        "story.speech_gap_before_drop",
        "sound.dip_before_drop"
      ]
    },
    {
      "id": "reveal",
      "at": [
        0.3,
        0.38
      ],
      "purpose": "the product appears acting on itself (a field typing, a window drawing), then the name builds",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "full",
        "events": [
          "hero_hit_on_name",
          "riser_ends_frame_before"
        ]
      },
      "rules": [
        "visual.product_as_actor",
        "hook.real_product_early",
        "sound.hero_hit_over_bed",
        "sound.riser_ends_frame_before_hit",
        "story.product_quiet_turn",
        "sound.hit_on_f_plus_1"
      ]
    },
    {
      "id": "demo",
      "at": [
        0.38,
        0.72
      ],
      "purpose": "4-7 chapters of 3-5 s: a 2-5 word label with one accent word beside real UI doing that job; a state change on the grid every 1.1-1.9 s",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "full",
        "events": [
          "one_sound_per_ui_action",
          "state_change_on_grid"
        ]
      },
      "rules": [
        "story.chapter_label_ui",
        "story.verb_chapter_cards",
        "type.key_word_accent",
        "pacing.state_change_every_1_2s",
        "sound.one_sound_per_ui_action",
        "visual.real_ui_composited",
        "type.typing_is_the_clock",
        "honesty.placeholder_labelled_in_frame",
        "story.one_running_example",
        "visual.one_accent_colour"
      ]
    },
    {
      "id": "proof",
      "at": [
        0.72,
        0.85
      ],
      "purpose": "exactly one defensible, sourced number or result; the loudest moment lands on the result state, not the logo",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "pulled_back",
        "events": [
          "one_soft_hit_on_number"
        ]
      },
      "rules": [
        "honesty.digit_needs_source",
        "story.launch_one_defensible_number",
        "sound.loudest_on_state_change",
        "honesty.label_hold_2s",
        "type.reading_time_hold"
      ]
    },
    {
      "id": "name",
      "at": [
        0.85,
        0.89
      ],
      "purpose": "the name alone: the bed drops to about -50 dB for 1.0-1.5 s under it, then returns for the tagline",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "silence",
        "events": [
          "bed_dip_-50db_1.5s"
        ]
      },
      "rules": [
        "sound.silence_under_name",
        "sound.planned_quiet_maxima"
      ]
    },
    {
      "id": "end",
      "at": [
        0.89,
        1.0
      ],
      "purpose": "tagline (one accent word), URL or one verb; held 3 s or more; the sound decays 2-4 s under the card",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "decay",
        "events": [
          "decay_tail_2-4s"
        ]
      },
      "rules": [
        "pacing.end_card_hold",
        "visual.end_card_layout",
        "sound.decay_tail",
        "story.cta_window",
        "distribution.cta_one_verb",
        "distribution.no_spoken_cta_builders",
        "delivery.clean_tail"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -11,
      -7
    ],
    "quiet_open_s": [
      1,
      2
    ],
    "sound_enter_by_s": 0.25,
    "bass_entry_pct": [
      0.23,
      0.35
    ],
    "bass_entry_note": "measured 23-52% in tier-A music-led films (median ~24%); default 0.30, on the turn line",
    "turn_silence_s": [
      0.3,
      0.5
    ],
    "name_silence_s": [
      1.0,
      1.5
    ],
    "name_silence_db": -50,
    "name_at_pct": [
      0.85,
      0.89
    ],
    "tail": "decay",
    "tail_s": [
      2,
      4
    ],
    "tail_db_max": -25,
    "bass_share": [
      0.27,
      0.47
    ],
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_tech_pulse_loop8",
      "music/bed_uplift_corporate_loop8",
      "music/bed_anthem_build_loop8",
      "music/bed_ambient_pad_loop8"
    ],
    "mode": "music"
  },
  "hooks": [
    "claim-or-question",
    "payoff-first",
    "promise",
    "problem-agitate",
    "founder-to-camera",
    "in-medias-res"
  ],
  "end_shapes": [
    "decay",
    "quiet-hold",
    "sting"
  ],
  "post": {
    "pattern": "3+ separable claims: hero film, then one numbered proof clip per claim about 2 min apart in one sitting, link in the first or last reply. One free or open tool from a founder: one single post, link inline at the end. Post 12:30-16:00 UTC; tell real people first; reply by hand for 36 h.",
    "rules": [
      "distribution.hero_plus_numbered_thread",
      "distribution.single_post_founder",
      "distribution.link_in_first_comment",
      "distribution.link_inline_end",
      "distribution.launch_window_utc",
      "distribution.hour1_people_not_pods",
      "distribution.first_line_archetype",
      "distribution.reply_by_hand_one_voice",
      "distribution.next_day_new_angle",
      "distribution.teaser_day_before",
      "distribution.expected_follower_multiple",
      "distribution.judge_by_saves",
      "distribution.numbered_clip_copy",
      "platform.x_landscape_ok",
      "platform.native_upload_x"
    ]
  },
