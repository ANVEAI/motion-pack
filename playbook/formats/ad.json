  "post": {
    "pattern": "Three hook variants on one body; keep the variant with the best measured 3 s hold and average view duration; change one thing per test.",
    "rules": [
      "distribution.hook_variant_test",
      "distribution.one_change_per_test",
      "hook.three_variants_one_body"
    ]
  },
  "recommended_parts": {
