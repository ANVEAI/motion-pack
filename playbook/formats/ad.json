{
  "id": "ad",
  "title": "Ad (15 s / 30 s, paid or organic)",
  "use_when": "A direct-response or brand ad for feeds and pre-roll: value inside 3 s, the brand inside the action by 5-7 s, one product moment, one proof, a CTA end card.",
  "length_s": [
    6,
    30
  ],
  "//length": "15 s and 30 s masters plus a 6 s bumper; 45 s is a stretch.",
  "aspects": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "lead_aspect": "9:16",
  "template": "templates/ad",
  "signals": {
    "keywords": [
      "ad",
      "advert",
      "commercial",
      "promo",
      "pre-roll",
      "paid",
      "campaign",
      "bumper",
      "15 s",
      "30 s",
      "cta"
    ],
    "product_types": [
      "any",
      "d2c",
      "app",
      "saas",
      "ecommerce"
    ],
    "goals": [
      "sell",
      "awareness"
    ],
    "platforms": [
      "reels",
      "tiktok",
      "youtube",
      "meta",
      "shorts"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.17
      ],
      "purpose": "the value in the first 3 s (15 s: hook ends by 2.5 s); at least 3 visual states in the first 5 s; impact on frame 0",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "full",
        "events": [
          "impact_frame_0",
          "whoosh_first_cut"
        ]
      },
      "rules": [
        "hook.value_by_3s",
        "pacing.hook_three_states",
        "hook.frame0_moving",
        "hook.first_sound_by_frame3",
        "hook.text_by_0_3s",
        "hook.no_offer_as_hook"
      ]
    },
    {
      "id": "problem",
      "at": [
        0.17,
        0.33
      ],
      "purpose": "the problem in one shot or two",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": []
      },
      "rules": [
        "pacing.asl_hype_ad",
        "pacing.interrupt_ladder"
      ]
    },
    {
      "id": "product",
      "at": [
        0.33,
        0.6
      ],
      "purpose": "the product inside the action; the brand cue lands by 5 s (TikTok, paid YouTube, feed ads), 6 s (Reels/Shorts) or 7 s (X/LinkedIn); riser into a hit on the reveal",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "full",
        "events": [
          "riser_ends_frame_before_reveal",
          "hit_on_reveal"
        ]
      },
      "rules": [
        "hook.brand_cue_deadline",
        "sound.riser_ends_frame_before_hit",
        "sound.hero_hit_over_bed",
        "visual.mark_in_world"
      ]
    },
    {
      "id": "proof",
      "at": [
        0.6,
        0.83
      ],
      "purpose": "a real number, real UI or a permitted testimonial only; ticks on proof",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "ticks"
        ]
      },
      "rules": [
        "honesty.digit_needs_source",
        "hook.social_proof_sourced",
        "honesty.quote_needs_source"
      ]
    },
    {
      "id": "cta",
      "at": [
        0.83,
        1.0
      ],
      "purpose": "one verb, one destination; the end card held at least 1.8 s (2.0 s on a 30 s); a sonic logo; the last 0.15 s silent",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "decelerate",
        "events": [
          "sonic_logo",
          "clean_tail"
        ]
      },
      "rules": [
        "story.cta_window",
        "pacing.end_card_hold",
        "distribution.cta_one_verb",
        "visual.end_card_layout",
        "delivery.clean_tail"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "impact on frame 0",
    "tail": "sonic-logo",
    "bass_share": [
      0.5,
      0.61
    ],
