{
  "id": "chat-skit",
  "title": "Chat skit (comedy in chat bubbles)",
  "use_when": "A short comedy told in a text thread or group chat: a stake on the first bubble, three escalating beats, a twist punchline, a callback, a send-to close. The product stays out of the video.",
  "length_s": [
    10,
    15
  ],
  "//length": "Pay off early: a punchline at 7-8 s reaches far more viewers than one at 14 s; cut to 12-15 s for Shorts.",
  "aspects": [
    "9:16"
  ],
  "lead_aspect": "9:16",
  "template": "templates/character-spot",
  "//template": "No chat template exists; character-spot is the closest (comedy, send line, twist on a smash). Build the thread with social.chatBubbles.",
  "signals": {
    "keywords": [
      "chat",
      "text thread",
      "group chat",
      "whatsapp-style",
      "comedy",
      "skit",
      "meme",
      "relatable",
      "office humour",
      "dm"
    ],
    "product_types": [
      "any",
      "b2b",
      "office tool"
    ],
    "goals": [
      "entertain",
      "awareness"
    ],
    "platforms": [
      "shorts",
      "reels",
      "tiktok"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.08
      ],
      "purpose": "the stake itself as the first bubble on frame 0 (a client, money, a deadline, a secret), never a name or greeting; a reacting face inside the safe area helps",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "body",
        "events": [
          "bubble_sound"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.text_by_0_3s",
        "hook.first_sound_by_frame3",
        "platform.vertical_safe_rect"
      ]
    },
    {
      "id": "escalation",
      "at": [
        0.08,
        0.45
      ],
      "purpose": "three beats, each worse than the last; one idea per bubble, readable in a beat; a sound per bubble",
      "required": true,
      "text": {
        "max_words": 7
      },
      "sound": {
        "level": "body",
        "events": [
          "sound_per_bubble"
        ]
      },
      "rules": [
        "type.reading_time_hold",
        "sound.repetition_round_robin",
        "pacing.sub_second_beats"
      ]
    },
    {
      "id": "twist",
      "at": [
        0.45,
        0.55
      ],
      "purpose": "the reversal punchline by about 5-8 s; hard-cut the music on it",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "cut_to_silence",
        "events": [
          "music_hard_cut",
          "smash"
        ]
      },
      "rules": [
        "hook.twist_by_5s",
        "sound.smash_pre_silence",
        "story.one_turn_in_window"
      ]
    },
    {
      "id": "callback",
      "at": [
        0.55,
        0.78
      ],
      "purpose": "one line after the music cut that rewards regulars (a running number, a time, a phrase)",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "dry",
        "events": []
      },
      "rules": [
        "pacing.reaction_hold"
      ]
    },
    {
      "id": "send",
      "at": [
        0.78,
        1.0
      ],
      "purpose": "\"send this to ...\" naming a person the viewer knows",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "sting"
        ]
      },
      "rules": [
        "distribution.send_line",
        "pacing.end_card_hold"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "sound on frame 0 (a bubble)",
    "twist_music_cut": true,
    "tail": "sting",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_comedy_pizzicato_loop8",
      "music/bed_playful_bounce_loop8",
      "music/bed_lofi_warm_loop8"
    ],
    "mode": "music"
  },
  "hooks": [
    "in-medias-res",
    "pattern-break",
    "curiosity-gap"
  ],
  "end_shapes": [
    "sting"
  ],
  "post": {
    "pattern": "Title = the stake in searchable words; caption line 1 the money/client/deadline stake inside 125 characters; at least 1 story film per 2 chat-skits, at most 3-4 chats a week; 4 h between top-level posts.",
    "rules": [
      "distribution.film_to_chat_ratio",
      "distribution.caption_stake_first_125",
      "distribution.title_stake_first",
      "distribution.post_spacing",
      "distribution.no_batch_posting",
      "platform.shorts_length_12_15"
    ]
  },
  "recommended_parts": {
    "hook": [
      "social.chatBubbles",
      "social.typing",
      "sfx/device/message_received"
    ],
    "escalation": [
      "social.chatBubbles",
      "social.replyBubble",
      "sfx/device/message_sent",
      "sfx/device/message_received",
      "sfx/device/phone_buzz"
    ],
    "twist": [
      "sfx/tx/smash_cut",
      "sfx/cartoon/record_scratch",
      "cuts/smash"
    ],
    "callback": [
      "social.replyBubble"
    ],
    "send": [
      "sfx/stinger/win",
      "music/sting_bounce_out"
    ],
    "all": [
      "music/bed_comedy_pizzicato_loop8",
      "music/bed_playful_bounce_loop8",
      "music/bed_lofi_warm_loop8"
    ]
  },
  "exemplars": [
    {
