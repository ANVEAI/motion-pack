          "at": [
            0.08,
            0.45
          ],
          "purpose": "three escalating beats",
          "text": "one idea per bubble",
          "sound": "sound per bubble"
        },
        {
          "at": [
            0.45,
            0.55
          ],
          "purpose": "twist punchline",
          "text": "",
          "sound": "music hard-cut"
        },
        {
          "at": [
            0.55,
            0.78
          ],
          "purpose": "callback line",
          "text": "",
          "sound": ""
        },
        {
          "at": [
            0.78,
            1.0
          ],
          "purpose": "send-to close",
          "text": "\"send this to ...\"",
          "sound": "sting"
        }
      ],
      "end_shape": "sting",
      "sources": [
        {
          "doc": "skills/story-script/references/formats.md",
          "locator": "Chat skit"
        }
      ]
    },
    {
      "id": "cs-channel-28d",
      "label": "own channel, chat-skits vs story films on Shorts (28 days, 12-15 s cuts)",
      "grade": "measured",
      "tier": "own analytics (negative evidence)",
      "length_s": 15,
      "aspect": "9:16",
      "beats": [
        {
          "at": [
            0,
            0.33
          ],
          "purpose": "every top Short lost half its viewers between 4 and 8 s",
          "text": "",
          "sound": ""
        }
      ],
      "sources": [
        {
          "doc": "private:memory/channel-analytics-2026-10-16",
          "locator": "Shorts, 28 days"
        }
      ],
      "notes": "Chat-skits: median 4 views; story films: median 44 (11x), 17-29% of film viewers stayed; 83% swipe away. Keep chats a minority (distribution.film_to_chat_ratio) and land the twist by ~5 s."
    }
  ],
