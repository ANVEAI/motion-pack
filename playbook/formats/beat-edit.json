{
  "id": "beat-edit",
  "title": "Beat edit (music-led montage)",
  "use_when": "A montage cut to a track: a reel, a portfolio, a tool tour on music, a style ladder. The track is the clock.",
  "length_s": [
    8,
    40
  ],
  "//length": "Tier-A beat montages 10.3 s and 37.8 s; a 20 s teaser with the drop at half time.",
  "aspects": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "lead_aspect": "9:16",
  "template": "templates/beat-edit",
  "signals": {
    "keywords": [
      "montage",
      "reel",
      "music video",
      "beat",
      "edit",
      "portfolio",
      "showreel",
      "hype",
      "sizzle",
      "tour"
    ],
    "product_types": [
      "creative tool",
      "agency",
      "portfolio",
      "brand",
      "music"
    ],
    "goals": [
      "awareness",
      "entertain"
    ],
    "platforms": [
      "reels",
      "shorts",
      "tiktok",
      "x"
    ]
  },
  "beats": [
    {
      "id": "intro",
      "at": [
        0,
        0.15
      ],
      "purpose": "the track and the first image land together; a short question or one-word-per-shot sentence; loud from frame 0 is fine",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "full_or_quiet",
        "events": [
          "audible_frames_0_3"
        ]
      },
      "rules": [
        "hook.first_sound_by_frame3",
        "hook.frame0_moving",
        "type.sentence_across_shots",
        "sound.loud_open_type_led"
      ]
    },
    {
      "id": "build",
      "at": [
        0.15,
        0.5
      ],
      "purpose": "accelerating: every bar -> every 2 beats -> every beat -> eighths (1-2 bars max); the riser ends one frame before the drop",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "building",
        "events": [
          "riser_whole_bars"
        ]
      },
      "rules": [
        "pacing.asl_beat_edit",
        "pacing.accelerando_montage",
        "sound.riser_ends_frame_before_hit",
        "music.phrase_cuts"
      ]
    },
    {
      "id": "drop",
      "at": [
        0.5,
        0.85
      ],
      "purpose": "double time: one cut per beat (0.4-1.0 s), hits on the grid only, at most 2 longer holds; a near-silent dip of 0.1-0.5 s right before the drop",
      "required": true,
      "text": {
        "max_words": 2
      },
      "sound": {
        "level": "full",
        "events": [
          "dip_before_drop",
          "cut_per_beat"
        ]
      },
      "rules": [
        "pacing.sub_second_beats",
        "sound.dip_before_drop",
        "sound.sync_rule_by_mode",
        "sound.sync_above_chance",
        "pacing.style_ladder",
        "motion.flash_limit"
      ]
    },
    {
      "id": "out",
      "at": [
        0.85,
        1.0
      ],
      "purpose": "breathe out; a loop seam back to frame 0, or an end hit / slam with a URL card",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "decay_or_slam",
        "events": [
          "end_hit"
        ]
      },
      "rules": [
        "motion.loop_seam",
        "pacing.end_card_hold"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_note": "loud from frame 0 is normal (open -0.3 dB measured)",
    "bass_entry_pct": [
      0.45,
      0.55
    ],
    "tail": "slam | decay | loop",
    "bass_share": [
      0.46,
      0.75
    ],
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "onset_share_min": 0.6,
    "beds": [
      "music/bed_hype_house_loop8",
      "music/bed_trap_half_loop8",
      "music/bed_dnb_170_loop8",
      "music/bed_hype_house_reel15"
    ],
    "mode": "music"
  },
  "hooks": [
    "pattern-break",
    "payoff-first",
    "curiosity-gap"
  ],
  "end_shapes": [
    "slam",
    "decay",
    "loop"
  ],
  "post": {
    "pattern": "One line (\"point of view\" or the stake); a fixed series slot if it is a series; judge by saves and views per follower.",
    "rules": [
      "distribution.fixed_series_slot",
      "distribution.judge_by_saves",
      "distribution.no_batch_posting"
    ]
  },
  "recommended_parts": {
    "intro": [
      "type/scaleSlam",
      "type.sentenceAcrossShots",
      "cuts/beat/every_2"
    ],
    "build": [
      "sfx/riser/noise_2bar",
      "sfx/riser/supersaw_2bar",
      "cuts/sections/build_accelerate"
    ],
    "drop": [
      "transitions/cut",
      "transitions/scalePunch",
      "transitions/flash",
      "sfx/tx/scale_punch",
      "cuts/sections/drop_doubletime",
      "cuts/beat/every_beat",
      "cuts/story/styleLadder"
    ],
    "out": [
      "title.endScreen",
      "sfx/hit/punch",
      "cuts/sections/breath_out"
    ],
    "all": [
      "music/bed_hype_house_loop8",
      "music/bed_trap_half_loop8",
      "music/bed_dnb_170_loop8",
      "music/bed_hype_house_reel15"
    ]
  },
