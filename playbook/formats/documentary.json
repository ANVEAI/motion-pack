{
  "id": "documentary",
  "title": "Documentary launch (multi-voice)",
  "use_when": "A people-led launch: several voices in their own words, the lead introduced late with one personal detail, chapters, the product as the thing they built, availability at the end.",
  "length_s": [
    107,
    185
  ],
  "//length": "Tier-A people-led documentaries ran 107-185 s; the template demo compresses the shape to 29 s.",
  "aspects": [
    "16:9"
  ],
  "lead_aspect": "16:9",
  "template": "templates/multi-voice-doc",
  "signals": {
    "keywords": [
      "team",
      "documentary",
      "behind the scenes",
      "people",
      "voices",
      "interview",
      "story of",
      "journey",
      "company"
    ],
    "product_types": [
      "model",
      "platform",
      "company",
      "research"
    ],
    "goals": [
      "launch",
      "awareness",
      "recruit"
    ],
    "platforms": [
      "youtube",
      "x",
      "linkedin"
    ]
  },
  "beats": [
    {
      "id": "voices",
      "at": [
        0,
        0.05
      ],
      "purpose": "4-6 different faces in cuts of 0.5-1.3 s inside the first 6 s, each mid-sentence, audio leading every cut, no name or product",
      "required": true,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "voices",
        "events": [
          "audio_leads_each_cut"
        ]
      },
      "rules": [
        "story.five_faces_cold_open",
        "hook.first_sound_by_frame3",
        "sound.split_edits"
      ]
    },
    {
      "id": "lead",
      "at": [
        0.05,
        0.15
      ],
      "purpose": "the lead and their name super with one personal detail beyond the role",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "voice",
        "events": []
      },
      "rules": [
        "type.name_super_one_detail",
        "type.lower_third_spec"
      ]
    },
    {
      "id": "chapters",
      "at": [
        0.15,
        0.7
      ],
      "purpose": "chapters of the work in their voices; the bed under speech ducked 9 dB or more",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "voice_bed",
        "events": [
          "duck_9db"
        ]
      },
      "rules": [
        "sound.duck_depth",
        "sound.speech_over_music",
        "type.captions_every_sentence",
        "pacing.asl_voice_led"
      ]
    },
    {
      "id": "proof",
      "at": [
        0.7,
        0.85
      ],
      "purpose": "one sourced proof; transcript bubbles anchored to the speaker are an option",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "voice_bed",
        "events": []
      },
      "rules": [
        "honesty.digit_needs_source",
        "honesty.verbatim_quote_gate"
      ]
    },
    {
      "id": "availability",
      "at": [
        0.85,
        0.95
      ],
      "purpose": "where and when it is available",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "bed_rises",
        "events": []
      },
      "rules": [
        "story.cta_window"
      ]
    },
    {
      "id": "close",
      "at": [
        0.95,
        1.0
      ],
      "purpose": "a closing line and the mark; decay",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "decay",
        "events": [
          "decay"
        ]
      },
      "rules": [
        "sound.decay_tail",
        "pacing.end_card_hold"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -12,
      -6
    ],
    "tail": "decay",
    "tail_db": -20,
    "bass_share": [
      0.15,
      0.36
    ],
    "lufs_reference_note": "references ran -17 to -19 LUFS; master to -14",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_documentary_marimba_loop8",
      "music/bed_ambient_pad_loop8",
      "music/bed_acoustic_folk_pluck_loop8"
    ],
    "mode": "vo"
  },
  "hooks": [
    "in-medias-res",
    "founder-to-camera",
    "cold-open"
  ],
  "end_shapes": [
    "decay",
    "slam"
  ],
  "post": {
    "pattern": "Single native post; the full film on YouTube with chapters.",
    "rules": [
      "platform.native_upload_x",
      "distribution.single_post_founder"
    ]
  },
  "recommended_parts": {
    "voices": [
      "caption.speakerTag",
      "cuts/story/voicesColdOpen",
      "cuts/split/J"
    ],
    "lead": [
      "lowerThird.docSuper"
    ],
    "chapters": [
      "title.chapterCard",
