{
  "id": "character-spot",
  "title": "Character spot (wordless, one gag, one feature)",
  "use_when": "A wordless cartoon or mime spot: one situation, one product benefit, at most 6 emotions on a neutral stage, a twist on a smash, a reaction hold, one end line.",
  "length_s": [
    12,
    32
  ],
  "//length": "15 s and 30 s versions; a 6 s cut-down exists.",
  "aspects": [
    "9:16",
    "16:9",
    "1:1"
  ],
  "lead_aspect": "9:16",
  "template": "templates/character-spot",
  "signals": {
    "keywords": [
      "cartoon",
      "mascot",
      "character",
      "mime",
      "wordless",
      "funny",
      "gag",
      "animated spot",
      "kids"
    ],
    "product_types": [
      "consumer app",
      "brand",
      "household product",
      "kids"
    ],
    "goals": [
      "entertain",
      "awareness",
      "sell"
    ],
    "platforms": [
      "reels",
      "shorts",
      "tiktok",
      "youtube"
    ]
  },
  "beats": [
    {
      "id": "hook",
      "at": [
        0,
        0.13
      ],
      "purpose": "the premise visible in 0-2 s; a cartoon sound on the premise, word-free babble",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "body",
        "events": [
          "cartoon_sound_on_premise"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.first_change_by_frame6",
        "story.one_gag_one_feature",
        "visual.character_comedy_clean"
      ]
    },
    {
      "id": "setup",
      "at": [
        0.13,
        0.33
      ],
      "purpose": "the format and the want; foley on every contact",
      "required": true,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "body",
        "events": [
          "foley_per_contact"
        ]
      },
      "rules": [
        "pacing.asl_character_spot",
        "pacing.same_scale_run"
      ]
    },
    {
      "id": "escalation",
      "at": [
        0.33,
        0.6
      ],
      "purpose": "escalating attempts; a freeze before the twist; drone then true silence over a 0.5 s freeze",
      "required": true,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "rising_then_silence",
        "events": [
          "freeze_then_silence"
        ]
      },
      "rules": [
        "sound.silence_before_turn",
        "story.character_spot_15s_beats"
      ]
    },
    {
      "id": "twist",
      "at": [
        0.6,
        0.73
      ],
      "purpose": "the reversal on a smash cut: 200 ms silence before, the hit on cut + 1 frame, 12 dB of contrast",
      "required": true,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "smash",
        "events": [
          "smash_hit_f_plus_1"
        ]
      },
      "rules": [
        "sound.smash_pre_silence",
        "story.one_turn_in_window",
        "sound.hit_on_f_plus_1"
      ]
    },
    {
      "id": "reaction",
      "at": [
        0.73,
        0.8
      ],
      "purpose": "a 1.5 s reaction close-up; one emotion sound",
      "required": true,
      "text": {
        "max_words": 0
      },
      "sound": {
        "level": "dry",
        "events": [
          "one_emotion_sound"
        ]
      },
      "rules": [
        "pacing.reaction_hold"
      ]
    },
    {
      "id": "message",
      "at": [
        0.8,
        1.0
      ],
      "purpose": "the end line and brand; a stinger; held 1.8 s or more",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "body",
        "events": [
          "stinger"
        ]
      },
      "rules": [
        "story.cta_window",
        "pacing.end_card_hold",
        "distribution.send_line"
      ]
    }
  ],
  "sound_shape": {
    "turn_silence_s": [
      0.2,
      0.4
    ],
    "smash_pre_silence_ms": 200,
    "tail": "sting",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_comedy_pizzicato_loop8",
      "music/bed_playful_bounce_loop8",
      "music/bed_chiptune_8bit_loop8"
    ],
    "mode": "music"
  },
  "hooks": [
    "pattern-break",
    "in-medias-res",
    "payoff-first"
  ],
  "end_shapes": [
    "sting"
  ],
  "post": {
    "pattern": "Single post with a send line naming a person; caption line 1 the situation.",
    "rules": [
      "distribution.send_line",
      "distribution.caption_stake_first_125"
    ]
  },
  "recommended_parts": {
    "hook": [
      "fx.emotion.question",
      "sfx/cartoon/boing",
      "sfx/voice/mumble",
      "layers/finish.bright-playful"
    ],
    "setup": [
      "sfx/cartoon/tiptoe",
      "sfx/foley/footstep_wood"
    ],
    "escalation": [
      "fx.emotion.sweat",
      "sfx/cartoon/slide_whistle_up",
      "sfx/tx/freeze_hit"
    ],
    "twist": [
      "fx.impact.speedLines",
      "sfx/tx/smash_cut",
      "sfx/cartoon/surprise_sting",
      "cuts/smash"
    ],
    "reaction": [
      "fx.emotion.heartBurst",
      "sfx/voice/wow"
    ],
    "message": [
      "title.endScreen",
      "music/bed_comedy_pizzicato_sting"
    ],
    "all": [
      "music/bed_comedy_pizzicato_loop8",
      "music/bed_playful_bounce_loop8",
      "music/bed_chiptune_8bit_loop8"
    ]
  },
