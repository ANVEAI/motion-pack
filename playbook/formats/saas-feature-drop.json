{
  "id": "saas-feature-drop",
  "title": "SaaS feature drop (one feature, one film)",
  "use_when": "A changelog or \"new in\" film for one feature of an existing product: the feature already working, its chapters, one use case, the name, the action.",
  "length_s": [
    15,
    40
  ],
  "//length": "Saves-strong plug-in tours ran 15.5-20 s; a tier-A VO-led feature film 37.8 s; release reels 45-90 s are a stretch case.",
  "aspects": [
    "16:9",
    "9:16",
    "1:1"
  ],
  "lead_aspect": "16:9",
  "template": "templates/saas-feature-drop",
  "signals": {
    "keywords": [
      "new feature",
      "changelog",
      "now in",
      "update",
      "just shipped",
      "feature",
      "integration",
      "plug-in",
      "extension",
      "release notes"
    ],
    "product_types": [
      "saas",
      "plug-in",
      "browser extension",
      "app",
      "developer tool"
    ],
    "goals": [
      "launch",
      "sell",
      "explain"
    ],
    "platforms": [
      "x",
      "linkedin",
      "youtube",
      "reels"
    ]
  },
  "beats": [
    {
      "id": "intro",
      "at": [
        0,
        0.15
      ],
      "purpose": "the feature already working on frame 0 (payoff-first) or the first UI action on frames 0-3; the name and a 3-word category line typed",
      "required": true,
      "text": {
        "max_words": 5
      },
      "sound": {
        "level": "quiet_or_ui",
        "events": [
          "first_ui_action_frames_0_3"
        ]
      },
      "rules": [
        "hook.frame0_moving",
        "hook.first_sound_by_frame3",
        "hook.payoff_first_rewind",
        "hook.real_product_early",
        "hook.brand_cue_deadline",
        "hook.text_by_0_3s"
      ]
    },
    {
      "id": "demo",
      "at": [
        0.15,
        0.7
      ],
      "purpose": "chapters of 3-5 s, each a 2-3 word label with one accent word beside the UI doing that job; one sound per UI action; a new state every 2-4 s",
      "required": true,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "body",
        "events": [
          "one_sound_per_ui_action"
        ]
      },
      "rules": [
        "story.chapter_label_ui",
        "sound.one_sound_per_ui_action",
        "pacing.new_state_every_3s",
        "pacing.static_hold_max",
        "visual.real_ui_composited",
        "visual.tall_ui_zoom_to_region",
        "type.key_word_accent",
        "honesty.ai_work_as_states",
        "honesty.placeholder_labelled_in_frame",
        "sound.silence_cues_action"
      ]
    },
    {
      "id": "usecases",
      "at": [
        0.7,
        0.85
      ],
      "purpose": "2-3 quick uses, cards swapping text in place about every 1.5 s",
      "required": false,
      "text": {
        "max_words": 4
      },
      "sound": {
        "level": "body",
        "events": [
          "tick_per_card"
        ]
      },
      "rules": [
        "type.accent_word_swap",
        "pacing.interrupt_ladder"
      ]
    },
    {
      "id": "name",
      "at": [
        0.85,
        0.89
      ],
      "purpose": "the name alone with the bed dropped to about -50 dB for 1-1.5 s",
      "required": true,
      "text": {
        "max_words": 3
      },
      "sound": {
        "level": "silence",
        "events": [
          "bed_dip_-50db"
        ]
      },
      "rules": [
        "sound.silence_under_name"
      ]
    },
    {
      "id": "outro",
      "at": [
        0.89,
        1.0
      ],
      "purpose": "logo + tagline, one action line (\"try it\" / URL); a soft hit on the lockup then a quiet tail",
      "required": true,
      "text": {
        "max_words": 6
      },
      "sound": {
        "level": "decay",
        "events": [
          "soft_lockup_hit",
          "quiet_tail"
        ]
      },
      "rules": [
        "pacing.end_card_hold",
        "story.cta_window",
        "visual.end_card_layout",
        "distribution.cta_one_verb",
        "sound.decay_tail"
      ]
    }
  ],
  "sound_shape": {
    "quiet_open_db": [
      -11,
      -7
    ],
    "quiet_open_s": [
      0.3,
      1.0
    ],
    "name_silence_s": [
      1.0,
      1.5
    ],
    "name_silence_db": -50,
    "tail": "decay",
    "tail_db_max": -25,
    "bass_share": [
      0.2,
      0.36
    ],
    "bass_share_note": "a VO-led feature film sits in the proof range (27% measured); a wordless UI tour may run 50-60% (brand-launch range)",
    "master_lufs": -14,
    "master_tp_wav_dbtp": -1.5,
    "delivered_tp_dbtp": -1.0,
    "beds": [
      "music/bed_corporate_bright_loop8",
      "music/bed_tech_pulse_loop8",
      "music/bed_lofi_warm_loop8"
    ],
    "mode": "continuous",
    "vo_wpm": [
      110,
      175
    ]
  },
  "hooks": [
    "payoff-first",
    "live-demo",
    "promise",
    "claim-or-question"
  ],
  "end_shapes": [
    "decay",
    "quiet-hold"
  ],
  "post": {
    "pattern": "Founder single post in the first person with concrete counts, link inline at the end; or one numbered clip inside a launch thread.",
    "rules": [
      "distribution.single_post_founder",
      "distribution.link_inline_end",
      "distribution.numbered_clip_copy",
      "distribution.judge_by_saves"
    ]
  },
  "recommended_parts": {
    "intro": [
      "type/typewriter",
      "ui.promptBar",
      "ui.appWindow",
      "title.hookCard",
      "sfx/ui/type_key",
      "sfx/ui/click",
      "cuts/sections/hook_3s"
    ],
    "demo": [
      "transitions/push",
      "transitions/cut",
      "transitions/zoomThrough",
      "title.chapterCard",
      "ui.cursorJourney",
      "ui.tabPillNav",
      "ui.checklist",
      "ui.stateMorph",
      "callout.uiHighlight",
      "sfx/ui/click",
      "sfx/ui/success",
      "sfx/ui/agent_working",
      "sfx/ui/swipe_ding",
      "sfx/whoosh/swish_xs"
    ],
    "usecases": [
      "type.accentSwap",
      "ui.notifyStack",
      "sfx/ui/tick",
      "sfx/ui/pop"
    ],
    "name": [
      "sfx/logo/two_note"
    ],
    "outro": [
      "title.endScreen",
      "sfx/hit/soft",
      "cuts/sections/breath_out"
    ],
    "all": [
      "music/bed_corporate_bright_loop8",
      "music/bed_tech_pulse_loop8",
      "music/bed_lofi_warm_loop8"
    ]
  },
